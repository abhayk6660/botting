# ==========================================
# GW JOIN BOT - ENVIRONMENT CONFIGURATION
# ==========================================

# Discord User Account Tokens
# Multiple accounts can be comma-separated: token1,token2,token3
DISCORD_TOKENS=your_discord_token_here

# Security Alert Webhook URL (Optional, for notifications on ban/kicks/alerts)
ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Trivia / Quiz Settings
# TRIVIA_MODE:
#   's' = natural human delay (3.5s - 6.5s) [Recommended]
#   'y' = fast delay (~1.5s - 2.2s)
#   'n' = trivia disabled
TRIVIA_MODE=s
MIN_TRIVIA_DELAY=3500
MAX_TRIVIA_DELAY=6500

# Minigame Only ('y' = disables repetitive canned chat messages, 'n' = chat enabled)
MINIGAME_ONLY=y

# Chat Mode: 's' (single mode), 'm' (multiple mode)
CHAT_MODE=s

# Port for Render Web Service (Render automatically sets this, default is 10000)
PORT=10000
